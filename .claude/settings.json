{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/hooks/dispatch-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/hooks/stop-lint.sh\"",
            "timeout": 120,
            "statusMessage": "Running platform gates (lint + secret scan)"
          }
        ]
      }
    ]
  }
}
